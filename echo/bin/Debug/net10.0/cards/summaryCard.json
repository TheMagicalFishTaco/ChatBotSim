{
    "type": "AdaptiveCard",
    "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
    "version": "1.6",
    "body": [
        {
            "type": "TextBlock",
            "wrap": true,
            "horizontalAlignment": "Center",
            "text": "Information Card"
        },
        {
            "type": "TextBlock",
            "text": "**Name:** ${name}",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "**Mobile Number:** ${mobileNum}",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "**Address:** ${address}",
            "wrap": true
        }
    ]
}